# ============================================================================
# CIO Predictivo 2.0 — Variables de entorno del backend
# Copie este archivo como .env y ajuste los valores antes de producción.
# ============================================================================

# Clave de firma JWT. OBLIGATORIA en producción (mínimo 32 caracteres aleatorios).
# Ejemplo para generar una: python -c "import secrets; print(secrets.token_urlsafe(48))"
CIO_SECRET_KEY=

# Vigencia del token en horas (por defecto 8).
CIO_TOKEN_HORAS=8

# Vigencia del refresh token en horas (por defecto 720 = 30 días).
CIO_REFRESH_HORAS=720

# Orígenes permitidos para CORS, separados por coma. No use "*" en producción.
CIO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Confiar en X-Forwarded-For para el rate limit de login (activar solo detrás
# de un proxy inverso controlado, p. ej. Nginx o Caddy).
CIO_TRUST_PROXY=0

# Habilitar Strict-Transport-Security (HSTS). Activar SOLO si el backend se
# sirve sobre HTTPS en producción.
CIO_ENABLE_HSTS=0

# Marcar las cookies de sesión con el atributo Secure. Activar SOLO si el
# backend se sirve sobre HTTPS en producción (requerido para cookies HttpOnly).
CIO_COOKIE_SECURE=0

# Directorio de respaldos (usado por backup_db.py y POST /api/admin/backup).
# CIO_BACKUP_DIR=/var/backups/cio-predictivo
# Cantidad de respaldos a conservar (rotación).
CIO_BACKUP_KEEP=14

# Tenant por defecto de esta instalación.
CIO_TENANT_ID=mina_los_colorados

# Ruta de la base SQLite. Por defecto: backend/cio_predictivo.db
# CIO_DB_PATH=/var/lib/cio-predictivo/cio_predictivo.db

# Administrador inicial (solo se crea si la tabla de usuarios está vacía).
CIO_ADMIN_EMAIL=admin@cpf.cl
CIO_ADMIN_PASSWORD=CambiarEstaClave123!
CIO_ADMIN_NOMBRE=Administrador CIO

# Importar firebase_data.json la primera vez que se inicia con la BD vacía.
CIO_IMPORTAR_FIREBASE=1
